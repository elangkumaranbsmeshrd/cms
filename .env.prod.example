# Production environment for docker-compose.prod.yml.
#   cp .env.prod.example .env    # then replace EVERY placeholder below
#
# Nothing here has a working default on purpose. compose refuses to start if a
# required value is missing, and the backend itself refuses to boot without
# SECRET_KEY / CREDENTIAL_ENCRYPTION_KEY — a missing secret should stop a
# deploy loudly, never fall back to something insecure.

# ---------------------------------------------------------------- database
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
MYSQL_DATABASE=meshrd_cms
MYSQL_USER=meshrd
MYSQL_PASSWORD=CHANGE_ME_app_db_password

# ------------------------------------------------------------------ secrets
# Generate, do not invent:
#   SECRET_KEY:                python -c "import secrets; print(secrets.token_urlsafe(64))"
#   CREDENTIAL_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CREDENTIAL_ENCRYPTION_KEY must be a valid Fernet key (44-char base64) — any
# other string fails at startup, not at first use.
# Rotating CREDENTIAL_ENCRYPTION_KEY makes already-encrypted values (e.g. saved
# SMTP credentials) undecryptable, so treat it as permanent once real data exists.
SECRET_KEY=CHANGE_ME_generate_a_64_char_random_value
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_generate_a_real_fernet_key

# ------------------------------------------------------------------ serving
# Host port for the SPA. Put a TLS terminator (host nginx, or a load balancer)
# in front of this — the frontend container speaks plain HTTP by design.
HTTP_PORT=80

# Leave EMPTY for the standard same-origin deployment: the SPA is served by the
# frontend container which proxies /api/ internally, so the browser makes no
# cross-origin request. Only set this if something on another origin calls the
# API directly. A wildcard here would be a real vulnerability, not a shortcut.
CORS_ALLOWED_ORIGINS=

# --------------------------------------------------------------- app tuning
# Rule of thumb: (2 x CPU cores) + 1. These are async uvicorn workers, so this
# is about CPU parallelism, not concurrency headroom.
GUNICORN_WORKERS=4

# -------------------------------------------------------------------- images
# Set by CI to a registry tag (e.g. ghcr.io/<owner>/cms-backend:<sha>).
# Left unset, compose builds from local source instead.
# BACKEND_IMAGE=
# FRONTEND_IMAGE=

# Serves the built Angular SPA and proxies the API on the SAME origin.
#
# Same-origin is the whole point: environment.prod.ts sets apiBaseUrl to the
# relative '/api/v1' precisely so the browser never makes a cross-origin call
# and the backend's cors_allowed_origins never needs to know this host's name.
# Mirrors ARCH-3 §9's server block, reduced to what belongs inside a container
# (TLS, certbot and the real server_name stay on the host nginx or the load
# balancer in front of this).
#
# This is a TEMPLATE. The nginx image's entrypoint runs envsubst over
# /etc/nginx/templates/*.template into /etc/nginx/conf.d/. It substitutes only
# variables that actually exist in the environment, so nginx's own $host /
# $remote_addr / $request_uri survive untouched — BACKEND_ORIGIN is the single
# value we inject.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Angular emits content-hashed filenames (outputHashing: "all"), so these
    # are safe to cache hard — changed content always arrives under a new name.
    location ~* \.(?:js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # index.html must NEVER be cached: it is the one file whose content changes
    # while its name does not, so a stale copy pins the browser to a bundle
    # that no longer exists — the classic white screen after a deploy.
    location = /index.html {
        add_header Cache-Control "no-store, must-revalidate";
    }

    location /api/ {
        # Resolve the backend at REQUEST time, not at startup. An `upstream`
        # block (or a literal host in proxy_pass) is resolved once when nginx
        # boots, so if the backend container is not up yet nginx exits with
        # "host not found in upstream" and the whole site is down — including
        # the static SPA, which does not need the backend at all. 127.0.0.11
        # is Docker's embedded DNS. With the address in a variable, a backend
        # restart or reschedule is picked up without restarting nginx.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $cms_api "${BACKEND_ORIGIN}";

        # $request_uri is required here: once proxy_pass contains a variable,
        # nginx stops appending the matched URI automatically.
        proxy_pass $cms_api$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        # Generous read timeout: payroll runs and PDF/Excel exports are the
        # genuinely slow endpoints here and exceed the 60s default.
        proxy_read_timeout   120s;

        # A backend that is down should read as a clean 502 from the API, while
        # the SPA itself keeps loading and can show its own error state.
        proxy_intercept_errors off;
    }

    # SPA deep links: /invoices/<id> is a client-side route with no file behind
    # it, so anything unmatched above falls through to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# Copy to .env and adjust for your environment. Never commit the real .env.

# Async URL (asyncmy) for the running application
DATABASE_URL=mysql+asyncmy://meshrd:meshrd_dev_password@127.0.0.1:3306/meshrd_cms

# Sync URL (PyMySQL) for Alembic, which does not run under asyncio
DATABASE_URL_SYNC=mysql+pymysql://meshrd:meshrd_dev_password@127.0.0.1:3306/meshrd_cms

SECRET_KEY=change-this-to-a-random-64-char-value-before-any-real-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=480

ENVIRONMENT=development

# Phase 6 — cross-cutting infrastructure
# Local filesystem root for uploaded files (locked stack: droplet-local storage, ARCH-3).
FILE_STORAGE_ROOT=./storage
# Fernet key encrypting Email Configuration's stored SMTP password / provider API key at
# rest. Generate a real one before any deployment: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=change-this-to-a-real-fernet-key-before-any-real-deployment
